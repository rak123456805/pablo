# Peblo TV Mini — Comprehensive Environment Variables
# Copy this file to .env before starting the stack.
# NEVER commit .env files containing real credentials to version control.

# ── Database Credentials ──────────────────────────────────────────────────────
# Asyncpg URL for application runtime queries
DATABASE_URL=postgresql+asyncpg://peblo:peblodev@db:5432/peblo

# Psycopg URL used exclusively by Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://peblo:peblodev@db:5432/peblo

# Test Database URL (used by pytest execution)
DB_TEST_URL=postgresql+asyncpg://peblo:peblodev@localhost:5433/peblo_test

# ── JWT Authentication & Security ─────────────────────────────────────────────
# MUST be set to a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Seed System Credentials ────────────────────────────────────────────────────
# System users created automatically by the seed script
ADMIN_EMAIL=admin@peblo.local
ADMIN_PASSWORD=admin123
EDITOR_EMAIL=editor@peblo.local
EDITOR_PASSWORD=editor123

# ── Storage Backend Configuration ─────────────────────────────────────────────
# Options: local | minio | r2
# To switch storage provider: change STORAGE_BACKEND and provide credentials below.
STORAGE_BACKEND=local

# Local storage settings (when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_BASE_URL=http://localhost:8000/static

# MinIO / S3 settings (when STORAGE_BACKEND=minio)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=peblo

# Cloudflare R2 Settings (Production — when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=peblo-catalogue-prod
R2_PUBLIC_DOMAIN=https://cdn.peblo.tv

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Allowed origins list for web client browser access
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174","http://localhost:80"]

# ── Application Paths & Flags ──────────────────────────────────────────────────
SEED_FILE_PATH=./seed_shows.json
DEBUG=false

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION SECRET HANDLING GUIDANCE:
# 1. Do NOT store real secrets in repository files or Docker images.
# 2. Inject JWT_SECRET_KEY, DATABASE_URL, and R2_SECRET_ACCESS_KEY at runtime
#    using HashiCorp Vault, AWS Secrets Manager, or Kubernetes Secrets.
# 3. Rotate JWT signing keys periodically using key ID (kid) headers.
# ──────────────────────────────────────────────────────────────────────────────
